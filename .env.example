# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True

# Allowed Hosts (comma-separated)
# Development:
ALLOWED_HOSTS=localhost,127.0.0.1
# Production:
# ALLOWED_HOSTS=photoalbum-backend.onrender.com

# CORS Allowed Origins (comma-separated)
# Development:
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Production:
# CORS_ALLOWED_ORIGINS=https://photo-album-hmr9.onrender.com

# Sentry Configuration
SENTRY_DSN=your-sentry-dsn-here

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=photo-album <your-email@gmail.com>

# PayU Configuration
PAYU_POS_ID=your-pos-id
PAYU_CLIENT_ID=your-client-id
PAYU_CLIENT_SECRET=your-client-secret
PAYU_SECOND_KEY=your-second-key
PAYU_BASE_URL=https://secure.snd.payu.com
# Development:
PAYU_NOTIFY_URL=https://yourdomain.com/api/payment/notify/
# Production:
# PAYU_NOTIFY_URL=https://photoalbum-backend.onrender.com/api/payment/notify/

# Frontend URL
# Development:
FRONTEND_URL=http://localhost:3000
# Production:
# FRONTEND_URL=https://photo-album-hmr9.onrender.com
